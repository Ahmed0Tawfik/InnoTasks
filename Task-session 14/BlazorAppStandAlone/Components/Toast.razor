<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
    @if (Show)
    {
        <div class="toast show border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body text-white rounded-3 p-3 d-flex align-items-center gap-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); animation: slideInRight 0.3s ease-out, fadeOut 0.3s ease-in 2.7s; box-shadow: 0 10px 25px rgba(102, 126, 234, 0.5);">
                <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px);">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z" />
                    </svg>
                </div>
                <div class="flex-grow-1 fw-medium">
                    @Message
                </div>
                <button type="button" class="btn-close btn-close-white opacity-75" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    .toast-body:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease;
    }
</style>